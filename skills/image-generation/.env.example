# ---------------------------------------------------------------------------
# image-generation skill / environment template
#
#   cp .env.example .env   # このスキルのディレクトリで実行
#
# 探索順: $GEMINI_ENV_FILE -> 実行ディレクトリの .env -> <skill>/.env
# 既にシェルに export 済みの環境変数が常に優先されます。
# .env は絶対にコミットしないこと。
# ---------------------------------------------------------------------------

# [必須] Google AI Studio (https://aistudio.google.com/apikey) で発行した API キー。
#        モデルと料金は公式料金表で確認してください。
GEMINI_API_KEY=

# [任意] 段階ごとのモデル固定。空 or auto = キーで使える最新の安定版を自動選択（推奨）。
#   proto  … gemini-*-flash-lite-image 系（試作）
#   final  … gemini-*-flash-image 系（本番）
#   ultra  … gemini-*-pro-image 系（最高品質・許可制）
IMAGE_GEN_MODEL_PROTO=auto
IMAGE_GEN_MODEL_FINAL=auto
IMAGE_GEN_MODEL_ULTRA=auto

# [任意] 1 にすると preview / experimental モデルも自動選択の候補に含める
IMAGE_GEN_ALLOW_PREVIEW=

# [任意] --aspect 省略時の縦横比。既定 1:1
IMAGE_GEN_DEFAULT_ASPECT=1:1

# [任意] 出力先ルート。既定は <実行ディレクトリ>/generated-images/（その下に YYYYMMDD/ を切る）
IMAGE_GEN_OUTPUT_ROOT=

# [任意] -n で複数枚生成するときの並列リクエスト数。既定 2
IMAGE_GEN_JOBS=2

# [任意] API リクエストのタイムアウト秒数。既定 300
IMAGE_GEN_TIMEOUT=300
